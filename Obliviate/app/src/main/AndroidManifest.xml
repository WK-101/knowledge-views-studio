<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Long-running wipe runs in a foreground service so the OS won't kill it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Progress notification (runtime prompt on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the CPU awake during a wipe so it completes with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Optional: "All files access" is ONLY used by the Junk Cleaner's full-storage
      scan, and is requested at runtime, on demand, when the user opts in. The core
      free-space wipe and the file shredder do NOT need it.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Pre-Android-11 fallback for the optional junk scan. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".ObliviateApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obliviate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Obliviate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.service.WipeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
