<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloads public, static list files. No contacts, phone, call-log or SMS permission: this app never
         sees who calls you. The build fails if any other permission appears (see build.gradle.kts). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WorkManager adds this for foreground work, which the updater never uses. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Only apps signed with the same key (Parley) can read the lists. Parley declares the same permission,
         so the grant works whichever app is installed first. -->
    <permission
        android:name="${listsPermission}"
        android:description="@string/permission_read_lists_description"
        android:label="@string/permission_read_lists_label"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Parley"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Read-only access to the packs, for Parley only. -->
        <provider
            android:name=".PacksProvider"
            android:authorities="${applicationId}.packs"
            android:exported="true"
            android:permission="${listsPermission}" />
    </application>
</manifest>
