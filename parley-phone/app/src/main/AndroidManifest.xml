<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Everything in this first block is granted automatically when Parley becomes the default phone app. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Normal permissions (granted at install). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- App lock: the system's own biometric / screen-lock prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Sensitive screens hide other apps' overlays (Android 12+), so a tap can't be tricked. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Health check: tells you when contacts sync is off for an account. -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />

    <!-- Optional, requested only when the user turns on the feature that needs it. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Reads packs from the optional "Parley Lists" companion app. A signature permission: only granted
         when both apps are signed with the same key. Parley still has no network access. -->
    <uses-permission android:name="${listsPermission}" />

    <!-- Parley has NO internet permission. The build fails if any library tries to add it. -->
    <!-- WorkManager asks for network state for network constraints, which Parley never uses. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Also declared by the companion app; declaring it here too makes the grant work whichever is installed first. -->
    <permission
        android:name="${listsPermission}"
        android:description="@string/permission_read_lists_description"
        android:label="@string/permission_read_lists_label"
        android:protectionLevel="signature" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Messenger apps: exactly the packages of MessengerCatalog (core/common), checked by MessengerCatalogTest.
             "Message or call on…" lists only these chat apps, and only when installed. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="im.molly.app" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.viber.voip" />
        <!-- Apps that open messenger handles (Threema, Matrix, XMPP…), and Message on… for private contacts. -->
        <package android:name="ch.threema.app" />
        <package android:name="ch.threema.app.libre" />
        <package android:name="ch.threema.app.work" />
        <package android:name="im.vector.app" />
        <package android:name="de.spiritcroc.riotx" />
        <package android:name="chat.fluffy.fluffychat" />
        <package android:name="eu.siacs.conversations" />
        <package android:name="im.quicksy.client" />
        <package android:name="org.monocles.chat" />
        <package android:name="com.discord" />
        <package android:name="com.skype.raider" />
        <package android:name="chat.simplex.app" />
        <package android:name="org.telegram.plus" />
        <package android:name="org.telegram.messenger.beta" />
        <!-- Apps whose contacts rows "Message or call on…" opens, so the intent goes to the app that owns the row. -->
        <package android:name="com.imo.android.imoim" />
        <package android:name="im.thebot.messenger" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="im.molly.app.unifiedpush" />
        <package android:name="ch.threema.app.green" />
        <package android:name="ch.threema.app.onprem" />
        <!-- Messengers whose QR links "Scan QR" opens directly in the app (never QUERY_ALL_PACKAGES). -->
        <package android:name="com.tencent.mm" />
        <package android:name="jp.naver.line.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.instagram.android" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.kakao.talk" />
        <package android:name="com.zing.zalo" />
        <package android:name="network.loki.messenger" />
        <package android:name="io.element.android.x" />
        <package android:name="com.wire" />
        <package android:name="org.briarproject.briar.android" />
        <!-- "Who can see your contacts": launcher apps only (never QUERY_ALL_PACKAGES). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- GrapheneOS detection (to point to Contact Scopes). -->
        <package android:name="app.grapheneos.apps" />
        <package android:name="app.grapheneos.info" />
        <package android:name="app.grapheneos.camera" />
        <package android:name="app.grapheneos.pdfviewer" />
        <package android:name="app.grapheneos.gmscompat" />
        <!-- The optional list updater companion. -->
        <package android:name="${listsPackage}" />
    </queries>

    <application
        android:name=".ParleyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Parley"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Parley.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CONTACTS" />
            </intent-filter>
            <!-- Static launcher shortcut "Message a number". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Required for the default dialer role. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/calls" />
            </intent-filter>
            <!-- Contacts -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.action.QUICK_CONTACT" />
                <action android:name="com.android.contacts.action.QUICK_CONTACT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.contacts.action.SHOW_OR_CREATE_CONTACT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
                <data android:scheme="mailto" />
            </intent-filter>
            <!-- Encrypted contact QR codes (parley://qr?d=...) opened by any QR scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="parley" android:host="qr" />
            </intent-filter>
            <!-- Shared rule-pack templates (parley://template?d=...), signed, opened by any QR scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="parley" android:host="template" />
            </intent-filter>
            <!-- A simple-mode setup (parley://simple?d=...), encrypted with a passcode, opened by any QR scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="parley" android:host="simple" />
            </intent-filter>
            <!-- Open or share a .vcf file to import it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <!-- Another app's "Edit contact" (a contact, lookup or raw contact URI), as AOSP Contacts declares it. -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <!-- "Scan QR code" for a picture shared to Parley (it is searched for codes on the phone). -->
            <intent-filter android:label="@string/qs_menu">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- A shared label's update or invitation file sent from any app, by its own type. -->
            <intent-filter android:label="@string/shl_open_with">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.parley.label-update" />
            </intent-filter>
            <!-- Apps often give an unknown file type as octet-stream: Parley's own files (an update, an invitation, an
                 encrypted vCard) are then known by their name, when the link shows it. Never every unknown file. The
                 patterns repeat for names with more dots (a pattern's ".*" stops at the first match). -->
            <intent-filter android:label="@string/shl_open_with">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.parleyupdate" />
                <data android:pathPattern=".*\\..*\\.parleyupdate" />
                <data android:pathPattern=".*\\..*\\..*\\.parleyupdate" />
                <data android:pathPattern=".*\\.parleyinvite" />
                <data android:pathPattern=".*\\..*\\.parleyinvite" />
                <data android:pathPattern=".*\\..*\\..*\\.parleyinvite" />
                <data android:pathPattern=".*\\.parley" />
                <data android:pathPattern=".*\\..*\\.parley" />
                <data android:pathPattern=".*\\..*\\..*\\.parley" />
            </intent-filter>
            <!-- The gear in Android's App info › "Parley" opens Parley's own Settings. -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Parley's own way into the main screen: its notifications, widgets, shortcuts and tiles start this alias with
             their internal actions (missed calls, a caller's page, Back up…). Not exported, so no other app can send
             them; MainActivity ignores those actions unless they came through here (IntentRoutes.OWN_ENTRY). -->
        <activity-alias
            android:name=".InternalEntry"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- A long press on one of Parley's Quick Settings tiles (Android sends it for every tile of the app): the
             Situation tile's opens Rescue call, every other tile's opens App info as before. Shows nothing itself. -->
        <activity
            android:name=".situations.TileLongPressActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Parley as the system contact picker (other apps choose contacts, numbers, e-mails, addresses). -->
        <activity
            android:name=".picker.PickerActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
                <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
                <data android:mimeType="vnd.android.cursor.dir/phone" />
                <data android:mimeType="vnd.android.cursor.dir/email_v2" />
                <data android:mimeType="vnd.android.cursor.dir/postal-address_v2" />
                <data android:mimeType="vnd.android.cursor.dir/postal-address" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/phone_v2" />
                <data android:mimeType="vnd.android.cursor.item/phone" />
                <data android:mimeType="vnd.android.cursor.item/email_v2" />
                <data android:mimeType="vnd.android.cursor.item/postal-address_v2" />
                <data android:mimeType="vnd.android.cursor.item/postal-address" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.contacts.action.JOIN_CONTACT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Call / Message with Parley" for numbers in selected or shared text, and the "Message on…" sheet.
             Deliberately no tel: filter here: phone links stay with the keypad. -->
        <activity
            android:name=".messaging.NumberActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Call / Message with Parley"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Parley.Sheet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="Call / Message with Parley">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Call or message a number">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The missed-call notification's "Call back", and widget or shortcut calls that ask first: the sheet above,
             reachable only by Parley's own intents, so no other app can place a call through it. -->
        <activity-alias
            android:name=".messaging.MissedCallBack"
            android:exported="false"
            android:targetActivity=".messaging.NumberActionActivity" />

        <!-- Home-screen shortcuts and widget trampoline (not exported; launchers start it for us). -->
        <activity
            android:name=".shortcuts.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".shortcuts.DialWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".shortcuts.DialWidget"
            android:exported="false"
            android:label="Direct dial">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dial_info" />
        </receiver>

        <!-- The Circle widget (resizable RemoteViews). -->
        <receiver
            android:name=".shortcuts.CircleWidget"
            android:exported="false"
            android:label="@string/circle_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_circle_info" />
        </receiver>

        <!-- The Favourites widget (resizable RemoteViews) and its settings: what a tap does. -->
        <activity
            android:name=".shortcuts.FavoritesWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".shortcuts.FavoritesWidget"
            android:exported="false"
            android:label="@string/fav_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites_info" />
        </receiver>

        <!-- Shares the encrypted "move to a new phone" backup file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Quick Settings tile: discreet mode for private contacts. -->
        <service
            android:name=".security.VaultTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_private"
            android:label="Private contacts"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Turning discreet mode off from the tile asks for the app lock first. -->
        <activity
            android:name=".security.DiscreetRevealActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|uiMode|keyboard|keyboardHidden|navigation|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Parley.Sheet" />

        <!-- Quick Settings tile: "Message a number" opens an empty number sheet; nothing shows over the lock screen. -->
        <service
            android:name=".messaging.MessageNumberTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_message"
            android:label="Message a number"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- Quick Settings tile "Scan QR" opens the scan screen (the camera app takes the photo, on a tap). -->
        <service
            android:name=".ui.qr.QrScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_qr"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- Quick Settings tile: "Expecting a call" lets unknown callers ring for a while. -->
        <service
            android:name=".blocking.ExpectingCallTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_expecting"
            android:label="Expecting a call"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Quick Settings tile: the Situation on now; each tap goes to the next one (Off at the end). -->
        <service
            android:name=".situations.SituationTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_situation"
            android:label="@string/sit_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- A rescue call's inexact alarm (no exact-alarm permission): only Parley's own PendingIntent reaches it. -->
        <receiver
            android:name=".rescue.RescueAlarmReceiver"
            android:exported="false" />
        <!-- Situations' time windows: the clock was set or the time zone changed (no permission needed). -->
        <receiver
            android:name=".situations.SituationClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Turn off on the Situation notice: only Parley's own PendingIntent reaches it. -->
        <receiver
            android:name=".situations.SituationNoticeReceiver"
            android:exported="false" />
        <receiver
            android:name=".blocking.BlockingActionReceiver"
            android:exported="false" />
        <!-- Notification actions on Android 10-11: an activity, so the lock screen asks to unlock first. -->
        <activity
            android:name=".blocking.BlockingActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Telecom delegates missed-call notifications to the default dialer. Only the system can send it. -->
        <receiver
            android:name=".MissedCallReceiver"
            android:exported="true"
            android:permission="android.permission.MODIFY_PHONE_STATE"
            tools:ignore="ProtectedPermissions">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".MissedCallActionReceiver"
            android:exported="false" />
        <!-- "Not now" and "Mark as wished" on reminder notifications. -->
        <receiver
            android:name=".work.CircleActionReceiver"
            android:exported="false" />
        <!-- Delete / Keep 7 more days / Keep permanently on the "temporary contacts are due" notification. -->
        <receiver
            android:name=".work.DueActionReceiver"
            android:exported="false" />
        <!-- "Remind me of missed calls": an inexact alarm, so no exact-alarm permission. -->
        <receiver
            android:name=".calls.MissedReAlertReceiver"
            android:exported="false" />
        <!-- "Not now" on the To call reminder. -->
        <receiver
            android:name=".calls.ToCallActionReceiver"
            android:exported="false" />
        <!-- "Remind me" on a missed-call notification: its three fixed times, after unlocking. -->
        <activity
            android:name=".calls.RemindMeActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|uiMode|keyboard|keyboardHidden|navigation|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Parley.Sheet" />

        <!-- "Don't allow" on a Directory request notification (see PrivateNameRequests). -->
        <receiver
            android:name=".privatenames.PrivateNameDecisionReceiver"
            android:exported="false" />
        <activity
            android:name=".privatenames.PrivateNameDecisionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Opt-in contacts Directory for private names. Disabled until turned on in Privacy › Private names in other phone apps;
             the Contacts Provider (which holds READ_CONTACTS) discovers it and forwards approved phone apps'
             lookups. It answers only "directories" and one exact number per phone_lookup. -->
        <provider
            android:name=".privatenames.PrivateDirectoryProvider"
            android:authorities="${applicationId}.privatedirectory"
            android:enabled="false"
            android:exported="true"
            android:readPermission="android.permission.READ_CONTACTS"
            android:writePermission="android.permission.WRITE_CONTACTS">
            <meta-data
                android:name="android.content.ContactDirectory"
                android:value="true" />
        </provider>

        <!-- Private contacts' photos, decrypted in memory for Parley's own screens only (not exported). -->
        <provider
            android:name=".privatenames.VaultPhotoProvider"
            android:authorities="${applicationId}.vaultphotos"
            android:exported="false" />
    </application>
</manifest>
