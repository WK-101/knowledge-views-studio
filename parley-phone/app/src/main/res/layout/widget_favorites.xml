<?xml version="1.0" encoding="utf-8"?>
<!-- The People widget in Favourites mode (RemoteViews, no Glance): a title, then rows of people added at run time.
     Small sizes hide the title. The background follows the system's widget corners and colours on Android 12+. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fav_root"
    style="@style/ParleyWidget"
    android:orientation="vertical">

    <TextView
        android:id="@+id/fav_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/label_favourites"
        android:textColor="@color/c2_widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fav_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/c2_widget_text"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fav_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical" />

</LinearLayout>
