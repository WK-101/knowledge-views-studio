<?xml version="1.0" encoding="utf-8"?>
<!-- Any Parley widget at one cell (or too low for its rows): one icon, and a short label when there is height for it.
     The icon takes the height left, at most 40 dp, so nothing is cut off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_root"
    style="@style/ParleyWidget"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/compact_icon"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxWidth="40dp"
        android:maxHeight="40dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/compact_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/c2_widget_text"
        android:textSize="12sp" />
</LinearLayout>
