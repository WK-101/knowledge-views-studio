<?xml version="1.0" encoding="utf-8"?>
<!-- One Situation in the widget. The Situation on now: filled. The text shrinks to fit rather than being cut off. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sit_chip"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="2dp"
    android:layout_weight="1"
    android:autoSizeMaxTextSize="13sp"
    android:autoSizeMinTextSize="9sp"
    android:autoSizeTextType="uniform"
    android:background="@drawable/widget_chip_on_bg_shape"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="1"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:textColor="@color/widget_chip_on_text" />
