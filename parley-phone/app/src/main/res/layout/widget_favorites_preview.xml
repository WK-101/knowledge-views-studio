<?xml version="1.0" encoding="utf-8"?>
<!-- The People widget's preview in the widget picker (Android 12+; RemoteViews, no Glance), at its 2×2 default. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ParleyWidget"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/label_favourites"
        android:textColor="@color/c2_widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/widget_favorites_preview_dot"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/circle_widget_preview_name_0"
            android:textColor="@color/c2_widget_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/widget_favorites_preview_dot"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/circle_widget_preview_name_1"
            android:textColor="@color/c2_widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/widget_favorites_preview_dot"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/fav_widget_preview_name_2"
            android:textColor="@color/c2_widget_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/widget_favorites_preview_dot"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/fav_widget_preview_name_3"
            android:textColor="@color/c2_widget_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
