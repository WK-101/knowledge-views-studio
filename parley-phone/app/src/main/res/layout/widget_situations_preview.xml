<?xml version="1.0" encoding="utf-8"?>
<!-- The Situations widget's preview in the widget picker (Android 12+), at its 2×1 default: a row of chips. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ParleyWidget"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip_on_bg_shape"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/sit_name_night"
        android:textColor="@color/widget_chip_on_text"
        android:textSize="13sp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip_off_bg_shape"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/sit_name_meeting"
        android:textColor="@color/c2_widget_text"
        android:textSize="13sp" />
</LinearLayout>
