<?xml version="1.0" encoding="utf-8"?>
<!-- The People widget in Circle mode (RemoteViews, no Glance): rows shown as the size allows
     (PeopleWidgetPlan.circleFit); one cell draws widget_compact instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/circle_root"
    style="@style/ParleyWidget"
    android:orientation="vertical">

    <TextView
        android:id="@+id/circle_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_circle"
        android:textColor="@color/c2_widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/circle_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/c2_widget_text"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/circle_person_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/circle_person_0_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c2_widget_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/circle_person_0_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c2_widget_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/circle_person_0_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_call_bg"
            android:contentDescription="@string/action_call"
            android:padding="10dp"
            android:src="@drawable/ic_widget_call" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/circle_person_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/circle_person_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c2_widget_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/circle_person_1_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c2_widget_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/circle_person_1_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_call_bg"
            android:contentDescription="@string/action_call"
            android:padding="10dp"
            android:src="@drawable/ic_widget_call" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/circle_person_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/circle_person_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c2_widget_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/circle_person_2_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c2_widget_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/circle_person_2_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_call_bg"
            android:contentDescription="@string/action_call"
            android:padding="10dp"
            android:src="@drawable/ic_widget_call" />
    </LinearLayout>

    <TextView
        android:id="@+id/circle_dates_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/label_coming_up"
        android:textColor="@color/c2_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/circle_date_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/c2_widget_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/circle_date_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/c2_widget_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/circle_date_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/c2_widget_text"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
