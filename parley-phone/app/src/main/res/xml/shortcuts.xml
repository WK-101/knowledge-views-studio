<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcut "Message a number" (the dynamic ones, New contact and favourites, come from
     Shortcuts.updateDynamic). src/debug has a copy with the debug package name. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_message"
        android:shortcutId="message_number"
        android:shortcutLongLabel="@string/shortcut_message_number_long"
        android:shortcutShortLabel="@string/shortcut_message_number_short">
        <intent
            android:action="app.parley.action.MESSAGE_NUMBER"
            android:targetClass="app.parley.messaging.NumberActionActivity"
            android:targetPackage="app.parley.phone" />
    </shortcut>
    <!-- "Scan QR" opens the scan screen, through Parley's own (unexported) entry: launchers start shortcuts as Parley. -->
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_qr"
        android:shortcutId="scan_qr"
        android:shortcutLongLabel="@string/qs_shortcut_long"
        android:shortcutShortLabel="@string/qs_shortcut_short">
        <intent
            android:action="app.parley.action.SCAN_QR"
            android:targetClass="app.parley.InternalEntry"
            android:targetPackage="app.parley.phone" />
    </shortcut>
    <!-- "Rescue call" opens its screen (who calls and when), one long press away rather than on the home screen. -->
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_rescue"
        android:shortcutId="rescue_call"
        android:shortcutLongLabel="@string/shortcut_rescue_long"
        android:shortcutShortLabel="@string/rescue_title">
        <intent
            android:action="app.parley.action.RESCUE_CALL"
            android:targetClass="app.parley.InternalEntry"
            android:targetPackage="app.parley.phone" />
    </shortcut>
    <!-- "Search everything" opens Recents' search with Recall on: "who called about the boiler in March?" -->
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search_everything"
        android:shortcutLongLabel="@string/shortcut_search_everything_long"
        android:shortcutShortLabel="@string/recall_chip">
        <intent
            android:action="app.parley.action.SEARCH_EVERYTHING"
            android:targetClass="app.parley.InternalEntry"
            android:targetPackage="app.parley.phone" />
    </shortcut>
</shortcuts>
