    <string name="recents_legend_menu">What do the colours mean?</string>
    <string name="recents_legend_title">Calls at a glance</string>
    <string name="recents_legend_missed">Solid circle: a call you missed. The row stays tinted, with a Call back button, until you call back.</string>
    <string name="recents_legend_declined">Solid square: a call you turned down.</string>
    <string name="recents_legend_incoming">Soft circle: a call you took. The bar shows how long you talked.</string>
    <string name="recents_legend_elsewhere">Dashed circle: taken on another device, like a watch.</string>
    <string name="recents_legend_voicemail">Soft square: they left a voicemail.</string>
    <string name="recents_legend_outgoing">Outlined circle: a call you made. The bar shows how long you talked.</string>
    <string name="recents_legend_no_answer">Dashed circle: you called and nobody picked up.</string>
    <string name="recents_legend_blocked">Crossed square: a call Parley or your phone blocked.</string>
    <string name="recents_legend_unknown">A call of an unknown kind.</string>
    <string name="recents_legend_footer">The shapes tell the calls apart too, so colour is never the only clue. Several calls in a row show a count and small dots, oldest first. Prefer plain icons? Settings › Recents style › Simple.</string>
    <string name="recents_style_rich">Rich</string>
    <string name="recents_style_simple">Simple</string>
    <string name="set_recents_style_title">Recents style</string>
    <string name="set_recents_style_summary">Rich: shapes, tints and a Call back button for missed calls. Simple: plain icons</string>
    <string name="set_recents_style_kw">rich, simple, colours, colors, icons, missed, call back, style, legend, colour blind</string>
    <!-- Recents chips by who called, and the quiet line under Unknown. -->
    <string name="recents_filter_unknown">Unknown</string>
    <string name="recents_filter_contacts">Contacts</string>
