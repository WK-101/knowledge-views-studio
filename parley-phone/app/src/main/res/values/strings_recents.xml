<!-- Recents at a glance: call classes, legend and Recents style. -->
<resources>
    <!-- Recents at a glance -->
    <string name="recents_class_no_answer">No answer</string>
    <string name="recents_not_returned">not called back yet</string>
    <string name="recents_call_back">Call back</string>
    <string name="recents_call_back_who">Call back %1$s</string>
    <string name="recents_count">%1$d×</string>
    <plurals name="recents_calls_sequence">
        <item quantity="one">%1$d call: %2$s</item>
