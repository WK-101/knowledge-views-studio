<?xml version="1.0" encoding="utf-8"?>
<!-- The root of every Parley widget: the background with the widget corners, and the inner padding. -->
<resources>
    <style name="ParleyWidget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/widget_circle_bg</item>
        <item name="android:padding">@dimen/widget_padding</item>
    </style>

    <dimen name="widget_padding">8dp</dimen>
    <dimen name="widget_radius">24dp</dimen>
</resources>
