<!-- The call quality diary: the Call insights "Quality" card and the number history's quality line. Patterns name
     the person, the SIM, Wi-Fi calling and the part of the day; Parley never knows where the phone was. -->
<resources>
    <string name="quality_title">Call quality</string>
    <string name="quality_explainer">From what the network reported for your calls in the last 60 days. Patterns use who, which SIM, Wi-Fi calling and the time of day, never where you were.</string>
    <string name="quality_none_dropped">No dropped calls</string>
    <plurals name="quality_dropped_of">
        <item quantity="one">%1$d of %2$d call dropped</item>
        <item quantity="other">%1$d of %2$d calls dropped</item>
    </plurals>
    <string name="quality_percent">%1$d%% dropped</string>
    <string name="quality_wifi">Wi-Fi calling</string>
    <string name="quality_mobile">Mobile network</string>

