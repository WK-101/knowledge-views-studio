    <string name="quality_subject_all">Calls</string>
    <string name="quality_pattern">%1$s often drop %2$s</string>
    <string name="quality_pattern_plain">%1$s often drop</string>
    <string name="quality_on_sim">on %1$s</string>
    <string name="quality_over_wifi">over Wi-Fi calling</string>
    <string name="quality_on_mobile">on the mobile network</string>
    <string name="quality_morning">in the morning</string>
