<?xml version="1.0" encoding="utf-8"?>
<!-- My card: signed card updates, "Shared with" and "Changed my number". -->
<resources>
    <!-- One-time tip on My card. -->
    <string name="card_signed_tip">Parley signs the card you share. When you change it, people who use Parley can update you in their contacts with one tap.</string>

    <!-- A newer card from a contact, on their page. %1$s: their name; %2$s: what changed, e.g. "new number, new email". -->
    <string name="card_update_banner">%1$s sent an updated card: %2$s</string>
    <string name="card_kind_name">new name</string>
    <string name="card_kind_number">new number</string>
    <string name="card_kind_email">new email</string>
    <string name="card_kind_work">new work details</string>
    <string name="card_kind_link">new link</string>
    <string name="card_kind_address">new address</string>
    <string name="card_update_review">Review</string>
    <string name="card_update_not_now">Not now</string>
    <!-- %1$s: the contact's name. -->
    <string name="card_update_title">Update %1$s?</string>
    <!-- %1$s: the signing key's short fingerprint. -->
    <string name="card_update_body">Signed with the same key as their earlier card (%1$s). Tick what to change:</string>
    <!-- %1$s: old value; %2$s: new value. -->
    <string name="card_change_replace">%1$s → %2$s</string>
    <string name="card_change_add">Add %1$s</string>
    <string name="card_change_remove">Remove %1$s</string>
    <string name="card_update_apply">Apply</string>
    <string name="card_update_apply_all">Apply all</string>
    <string name="card_update_ignore">Ignore</string>
    <string name="card_update_applied">Contact updated</string>
    <string name="card_update_failed">Couldn\'t update the contact</string>

    <!-- What a scanned code or opened file with a signed card means. %1$s: the contact's name. -->
    <string name="card_in_update">%1$s sent an updated card. You can review it on their page.</string>
    <string name="card_in_open">Open</string>
    <string name="card_in_current">%1$s\'s contact already has this card.</string>
    <string name="card_in_linked">Signed card, linked to %1$s: Parley will offer their future updates.</string>
    <string name="card_in_held">Signed card: once you save this contact, Parley will offer their future updates.</string>
    <!-- %1$s: the contact's name; %2$s: the other key's short fingerprint. -->
    <string name="card_in_different">This card says it\'s %1$s\'s, but a different key signed it (%2$s). It may not be from them, so nothing was offered.</string>
    <string name="card_in_broken">This card\'s signature doesn\'t match: it was changed after it was signed. Check the details with the person.</string>

    <!-- My card › Shared with. -->
    <string name="card_shared_title">Shared with</string>
    <string name="card_shared_open">See who has your card</string>
    <string name="card_shared_none">Nobody yet</string>
    <plurals name="card_shared_people">
        <item quantity="one">%1$d person</item>
        <item quantity="other">%1$d people</item>
    </plurals>
    <string name="card_shared_intro">Everyone Parley saw your card go to, newest first. Only you see this list; it stays on this phone and in your encrypted backups.</string>
    <string name="card_shared_empty">Nobody yet</string>
    <string name="card_shared_empty_body">When you swap QR codes, send your details or introduce yourself, the person shows here.</string>
    <string name="card_shared_unreadable">This list can\'t be opened right now. Try again in a moment.</string>
    <plurals name="card_shared_times">
        <item quantity="one">%1$d time</item>
        <item quantity="other">%1$d times</item>
    </plurals>
    <!-- %1$s: name or number. -->
    <string name="card_shared_remove_who">Remove %1$s</string>
    <string name="card_shared_remove_title">Remove %1$s from this list?</string>
    <string name="card_shared_remove_body">This only changes your list. They keep the card you gave them.</string>
    <string name="card_shared_clear">Clear list</string>
    <string name="card_shared_clear_title">Clear the whole list?</string>
    <!-- %1$s: the key's short fingerprint. -->
    <string name="card_shared_key">Your card\'s signing key: %1$s. Someone whose Parley shows this key on your card knows it came from you.</string>
    <string name="card_method_qr_swap">QR swap</string>
    <string name="card_method_send_details">Send my details</string>
    <string name="card_method_introduce">Introduce myself</string>
    <string name="card_method_file">Card file</string>
    <string name="card_method_new_number">New number</string>

    <!-- Changed my number. -->
    <plurals name="card_new_number_banner">
        <item quantity="one">You have a new number. %1$d person you shared your card with has the old one.</item>
        <item quantity="other">You have a new number. %1$d people you shared your card with have the old one.</item>
    </plurals>
    <string name="card_new_number_tell">Tell them</string>
    <string name="card_new_number_title">Changed my number</string>
    <string name="card_new_number_explainer">Parley opens one chat at a time with your new number filled in. You press Send; when you come back, the next person is ready. “Send my card” shares your signed card instead, so their Parley offers the update. Nothing is sent for you.</string>
    <!-- %1$s: your name; %2$s: your new number. -->
    <string name="card_new_number_message">Hi, it\'s %1$s. My new number is %2$s. Please update it in your contacts.</string>
    <!-- %1$s: your new number. -->
    <string name="card_new_number_message_no_name">Hi, my new number is %1$s. Please update it in your contacts.</string>
    <string name="card_new_number_copied">The message was copied. Paste it in the chat.</string>
    <string name="card_new_number_filled_in">The message is filled in</string>
    <string name="card_new_number_for_pasting">The message is copied for pasting</string>
    <string name="card_new_number_sms">SMS</string>
    <string name="card_new_number_send_card">Send my card</string>
    <string name="card_new_number_nobody">Everyone is up to date</string>
    <string name="card_new_number_nobody_body">Nobody in Shared with has an old number of yours.</string>
</resources>
