    <string name="contact_make_visible">Make visible to other apps</string>
    <string name="contact_make_visible_summary">Move them back to the phone\'s contacts</string>
    <string name="contact_make_private_title">Make %1$s private?</string>
    <string name="contact_make_private_body">They\'ll be kept only in Parley, encrypted. Messengers, keyboards and other apps with access to your contacts won\'t see them any more; a synced copy goes after the account\'s next sync. Everything on this page stays: details, photo, notes, your Circle, logged moments and the call-screen picture. Calls from them still show their name.</string>
    <string name="contact_make_visible_title">Make %1$s visible to other apps?</string>
    <string name="contact_make_visible_body">They\'ll move back to the phone\'s contacts, so apps with access to your contacts (messengers, keyboards, sync accounts) can see their name, numbers and other details. Notes, your Circle and logged moments stay in Parley. Calls in the private call history go back to the phone\'s call history.</string>
    <string name="contact_make_visible_confirm">Make visible</string>
    <string name="contact_made_visible">Visible to other apps now</string>
    <string name="contact_make_temporary">Delete automatically…</string>
    <string name="contact_make_temporary_summary">They delete themselves on a date you choose</string>
    <string name="contact_keep_permanently">Keep permanently</string>
    <string name="contact_keep_permanently_summary">They won\'t delete themselves</string>
    <string name="contact_private_qr_title">Show a private contact\'s details?</string>
    <string name="contact_private_qr_body">Whoever scans this code gets these details as an ordinary contact, which other apps on their phone can see.</string>
