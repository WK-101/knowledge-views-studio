    <!-- Call history: archive notices -->
    <string name="hist_archive_reset_title">Parley\'s call archive was reset</string>
    <string name="hist_archive_reset_text">Its encryption key was no longer available on this phone (this can happen after a system update or a security change), so a new archive was started. The old one was set aside, not deleted.</string>
    <string name="hist_archive_intro_title">Parley keeps its own copy of your calls</string>
    <string name="hist_archive_intro_text">Android may drop old calls, so Parley keeps an encrypted copy on this phone. Calls you clear in another app stay in Parley; delete them here, or turn the archive off in its settings.</string>
    <string name="hist_archive_settings">Archive settings</string>

    <!-- Call history settings -->
    <string name="hist_archive_on_summary">On: Parley keeps its own encrypted copy, because Android may drop old calls</string>
    <string name="hist_archive_off_summary">Off: only what Android keeps</string>
    <string name="hist_archive_off_title">Turn off the call-history archive?</string>
    <string name="hist_archive_off_text">Parley deletes its encrypted copy of your calls. Your phone\'s own call history is not changed, but calls Android already dropped are gone for good.</string>
    <string name="hist_archive_off_confirm">Turn off and delete</string>
    <string name="hist_settings_title">Call history</string>
    <string name="hist_keep_full">Keep full call history</string>
    <plurals name="hist_archive_count">
        <item quantity="one">%1$d call in Parley\'s archive</item>
        <item quantity="other">%1$d calls in Parley\'s archive</item>
    </plurals>
    <string name="hist_archive_explain">Some phones keep only the most recent calls. With this on, Parley copies every call into its own database on this phone, encrypted with a key kept in Android\'s secure key store, and shows those calls in Recents. Nothing leaves the phone. Calls you delete in Parley are removed from the copy too; calls deleted in other apps stay in it.</string>
    <plurals name="hist_retention_days">
        <item quantity="one">Your setting keeps call history for %1$d day; older calls are deleted from both, except numbers you keep forever.</item>
        <item quantity="other">Your setting keeps call history for %1$d days; older calls are deleted from both, except numbers you keep forever.</item>
    </plurals>
