    <!-- Settings › Calls › Phone menus: menu memory's own page. -->
    <string name="set_phone_menus_title">Phone menus</string>
    <string name="set_phone_menus_summary">The keys you pressed in a phone menu, offered again next time</string>
    <string name="set_phone_menus_kw">phone menu, ivr, menu keys, touch tones, dtmf, replay, direct my call</string>
    <string name="set_menu_memory_title">Remember menu keys</string>
    <string name="set_menu_memory_summary">Never 4 or more digits in a row, so PINs and card numbers aren\'t kept</string>
    <string name="set_menu_memory_kw">phone menu, ivr, menu keys, digits, touch tones, dtmf, pin, replay, last time</string>
    <string name="phone_menus_intro">When you call a number with a phone menu, the keys you pressed show on the keypad next time, so you can send them again with one tap. They stay on this phone and aren\'t in backups. Shortcuts you save stay either way.</string>
    <!-- Under "Phone menus" on the Calls page. -->
    <string name="phone_menus_on">Remembering menu keys</string>
    <string name="phone_menus_off">Not remembering menu keys</string>

    <!-- I12: long-press on the keypad's Call pill or a contact's Call. -->
    <string name="reason_call_with">Call with a reason…</string>
    <string name="reason_title">Call with a reason</string>
    <string name="reason_field">Reason</string>
    <string name="reason_placeholder">The parcel you sent</string>
    <!-- How the reason reaches them when the network carries it with the call. -->
    <string name="reason_subject_body">Shows on their phone while it rings, if their phone and network support it.</string>
    <!-- Without network support: the message the user sends themselves before the call. %1$s is the reason. -->
    <string name="reason_text_body">Your network can\'t send a reason with the call. Text first opens your messaging app with the message ready; you send it, then come back to call.</string>
    <string name="reason_no_way">Your network can\'t send a reason with the call, and there\'s no messaging app to text first.</string>
    <string name="reason_call">Call</string>
    <string name="reason_text_first">Text first</string>
    <string name="reason_message">Calling you about %1$s</string>
    <string name="reason_call_now_title">Call %1$s now?</string>
    <string name="reason_call_now_body">If you sent the text, they know why you\'re calling.</string>
    <string name="reason_not_now">Not now</string>
    <string name="reason_no_app">No messaging app to open</string>
    <string name="reason_tip">Press and hold Call to say why you\'re calling.</string>
