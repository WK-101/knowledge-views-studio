<?xml version="1.0" encoding="utf-8"?>
<!-- The benchmark APK, not Parley: these permissions are for seeding test contacts and calls on a test device and for
     ringing an emulator through its console. Parley itself still has none of them beyond what it declares. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="app.parley.phone" />
    </queries>
</manifest>
