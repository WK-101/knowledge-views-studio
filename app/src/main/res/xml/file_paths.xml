<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Imported PDFs live in filesDir/pdfs; shared out through the FileProvider. -->
    <files-path name="pdfs" path="pdfs/" />
    <!-- Downloaded article images / media staged in cacheDir/media before saving or sharing. -->
    <cache-path name="media" path="media/" />
    <!-- EPUB / HTML exports staged in cacheDir/exports before sharing out (Kindle, Kobo, etc.). -->
    <cache-path name="exports" path="exports/" />
</paths>
