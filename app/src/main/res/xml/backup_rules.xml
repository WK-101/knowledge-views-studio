<full-backup-content>
    <!-- Cairn keeps everything on-device. Cloud auto-backup is disabled;
         users export an encrypted archive explicitly (see Settings). -->
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
