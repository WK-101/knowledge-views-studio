<resources>
    <!-- Base activity theme: no action bar, transparent system bars (edge-to-edge in Compose). -->
    <style name="Theme.Cairn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Dark-aware window background (values-night overrides the color) so the post-splash
             window matches the Compose scheme instead of flashing framework near-white. -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch screen -->
    <style name="Theme.Cairn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Cairn</item>
    </style>
</resources>
