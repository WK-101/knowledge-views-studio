<?xml version="1.0" encoding="utf-8"?>
<!-- Notes quick widget: two buttons (New note · Today's note). A short 2×1 button strip. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="110dp"
    android:maxResizeWidth="250dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_note"
    android:previewLayout="@layout/widget_note"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_note_desc" />
