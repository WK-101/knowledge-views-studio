<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================================
         R104 — Shared home-screen-widget palette (DARK). Mirrors values/colors.xml;
         the system swaps to these automatically in dark mode for theme = "auto".
         Same token names → every widget layout stays theme-correct with no code.
         ============================================================================ -->
    <color name="w_surface">#F01A1B26</color>          <!-- softly translucent dark card -->
    <color name="w_surface_variant">#24273A</color>    <!-- inner tile (matrix quadrants) -->
    <color name="w_chip">#2AFFFFFF</color>             <!-- filter / activity chip -->
    <color name="w_text_primary">#FFFFFF</color>
    <color name="w_text_secondary">#B9B4D0</color>
    <color name="w_text_tertiary">#8A8699</color>
    <color name="w_on_accent">#FFFFFF</color>          <!-- text/icon on a filled accent (never flips) -->
    <color name="w_accent">#8C86FF</color>             <!-- filled accent (add pill, progress) — HexisColors brand-dark -->
    <color name="w_accent_text">#8C86FF</color>        <!-- accent-coloured text on the card -->
    <color name="w_teal">#4FD1C5</color>               <!-- time / habit brand teal -->
    <color name="w_danger">#EB6B6B</color>             <!-- overdue / over-capacity -->
    <color name="w_warning">#E0A63F</color>            <!-- amber -->
    <color name="w_info">#6E9BFF</color>               <!-- blue accent -->
    <color name="w_success">#4FC38A</color>            <!-- done / on-track green -->
    <color name="w_divider">#22FFFFFF</color>
    <color name="w_stroke">#22FFFFFF</color>
</resources>
