<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Hexis — "Four into one": four chevrons (tasks · habits · time · notes) converging on a single
         gold centre. A compass of the four modules, all pointing to one bearing — the next right thing.
         108-unit design space; the in-app KairoMark canvas mirrors these exact coordinates. -->

    <!-- Gold halo behind the core (the moment everything gathers to). -->
    <path android:pathData="M42,54 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 z"
        android:fillColor="#F5B01E" android:fillAlpha="0.22" />

    <!-- Four chevrons, light on the deep-indigo night, each leaning inward. -->
    <path android:pathData="M41,26 L54,39 L67,26" android:strokeColor="#ECE7F6"
        android:strokeWidth="7.5" android:strokeLineCap="round" android:strokeLineJoin="round" />
    <path android:pathData="M82,41 L69,54 L82,67" android:strokeColor="#ECE7F6"
        android:strokeWidth="7.5" android:strokeLineCap="round" android:strokeLineJoin="round" />
    <path android:pathData="M41,82 L54,69 L67,82" android:strokeColor="#ECE7F6"
        android:strokeWidth="7.5" android:strokeLineCap="round" android:strokeLineJoin="round" />
    <path android:pathData="M26,41 L39,54 L26,67" android:strokeColor="#ECE7F6"
        android:strokeWidth="7.5" android:strokeLineCap="round" android:strokeLineJoin="round" />

    <!-- The gold core — the one point the four resolve to. -->
    <path android:pathData="M47.5,54 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 z"
        android:fillColor="#F5B01E" />
</vector>
