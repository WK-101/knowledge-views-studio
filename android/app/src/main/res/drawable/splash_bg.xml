<?xml version="1.0" encoding="utf-8"?>
<!-- R71 — a plain solid-colour launch window. Deliberately NO vector here: the system's starting
     window inflates this before the app draws, and we keep it to a single colour so nothing on the
     cold-start path can fail to inflate. Compose paints the real branded UI immediately after. -->
<color xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ic_launcher_background" />
