<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme used before Compose draws. Compose handles light/dark at runtime. -->
    <style name="Theme.ToDoCompanion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Branded launch window: shows the app icon on the brand colour instantly, so the user
         never sees a blank frame while Compose + the database warm up. Swapped for the plain
         theme in MainActivity.onCreate before the first frame. -->
    <style name="Theme.ToDoCompanion.Splash" parent="Theme.ToDoCompanion">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <!-- R17/R64: a full-screen TRANSLUCENT (not floating) window for the quick-capture popup. The Compose
         ModalBottomSheet paints its own scrim + card, so the launcher shows through, dimmed, and a tap
         outside the sheet dismisses it. This MUST NOT be a Dialog / windowIsFloating theme: a floating
         window can't host a ModalBottomSheet (the sheet adds its own full-screen scrim window), which
         crashed the Quick-Add widget and the "Quick add" launcher shortcut the moment they opened. -->
    <style name="Theme.ToDoCompanion.QuickCapture" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
