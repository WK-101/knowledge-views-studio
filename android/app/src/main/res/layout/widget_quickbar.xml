<?xml version="1.0" encoding="utf-8"?>
<!-- R107 — the Quick-bar "island": a themeable rounded card, the action cluster drawn as one bitmap
     on top (a soft accent blob with discs, so it reads as a single object — not a row of buttons),
     and a transparent per-count tap grid (widget_qb_cluster_N) overlaid so each disc is tappable.
     The grid is filled at runtime (addView), and its weights mirror WidgetBitmaps.clusterPositions(N). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/qb_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/qb_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <FrameLayout
        android:id="@+id/qb_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
