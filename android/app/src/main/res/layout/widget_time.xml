<?xml version="1.0" encoding="utf-8"?>
<!-- Time tracker widget: a proper card — a clock icon + the running activity and a big live timer up
     top, then one-tap start chips and a round stop button. Bigger and iconized. Offline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/tw_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tw_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Not tracking"
            android:textColor="@color/w_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/tw_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_accent_text"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tw_a1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="11dp"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/w_text_primary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tw_a2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="11dp"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/w_text_primary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tw_a3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="11dp"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/w_text_primary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/tw_stop"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="fitCenter"
            android:contentDescription="Stop tracking"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
