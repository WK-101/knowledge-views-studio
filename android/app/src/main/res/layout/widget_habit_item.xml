<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hi_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingLeft="2dp"
    android:paddingRight="2dp">

    <ImageView
        android:id="@+id/hi_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Check off"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/hi_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Habit"
        android:textColor="@color/w_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/hi_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text=""
        android:textColor="@color/w_warning"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hi_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textColor="@color/w_text_secondary"
        android:textSize="12sp"
        android:fontFamily="monospace" />
</LinearLayout>
