<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dni_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/dni_rank"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="@color/w_text_tertiary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dni_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Task"
        android:textColor="@color/w_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dni_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:text=""
        android:textColor="@color/w_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
