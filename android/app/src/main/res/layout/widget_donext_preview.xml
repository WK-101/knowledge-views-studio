<?xml version="1.0" encoding="utf-8"?>
<!-- R105 — static, filled preview for the widget picker. Sample content only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Do Next" android:textColor="@color/w_text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_add_bg" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="＋" android:textColor="@color/w_on_accent" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/widget_chip_bg" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="⚡ Any energy" android:textColor="@color/w_text_primary" android:textSize="12sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_chip_bg" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="⏱ Any time" android:textColor="@color/w_text_primary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="10dp" android:text="○" android:textColor="@color/w_accent_text" android:textSize="17sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Finish the deck" android:textColor="@color/w_text_primary" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High · 45m" android:textColor="@color/w_text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="10dp" android:text="○" android:textColor="@color/w_accent_text" android:textSize="17sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Book the venue" android:textColor="@color/w_text_primary" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Med · 15m" android:textColor="@color/w_text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
