<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="HABITS TODAY" android:textColor="#B9B4D0" android:textSize="11sp" android:letterSpacing="0.1" />
    <TextView android:id="@+id/hs_done" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0/0" android:textColor="#FFFFFF" android:textSize="40sp" android:textStyle="bold" />
    <TextView android:id="@+id/hs_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="" android:textColor="#12A594" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
