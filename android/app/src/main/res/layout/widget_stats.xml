<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TODAY" android:textColor="@color/w_text_secondary" android:textSize="11sp" android:letterSpacing="0.1" />
    <TextView android:id="@+id/st_done" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0" android:textColor="@color/w_text_primary" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="done" android:textColor="@color/w_text_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/st_due" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="" android:textColor="@color/w_teal" android:textSize="12sp" />
</LinearLayout>
