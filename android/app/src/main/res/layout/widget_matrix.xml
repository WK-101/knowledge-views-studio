<?xml version="1.0" encoding="utf-8"?>
<!-- Eisenhower matrix widget: a real 2×2 board. Each quadrant is a scrolling list of its tasks (fills
     the space, scrolls for more), colour-coded, with the app's quadrant name + a live count. Tapping a
     task opens it. Card layer is a separate ImageView so runtime theme + opacity apply. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mx_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/mx_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="5dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

            <LinearLayout android:id="@+id/mx_q0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_margin="2.5dp" android:padding="9dp" android:background="@drawable/widget_tile_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="2dp">
                    <TextView android:id="@+id/mx_lbl0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/w_danger" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/mx_cnt0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/w_danger" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ListView android:id="@+id/mx_l0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
                <TextView android:id="@+id/mx_e0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Clear" android:textColor="@color/w_text_tertiary" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/mx_q1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_margin="2.5dp" android:padding="9dp" android:background="@drawable/widget_tile_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="2dp">
                    <TextView android:id="@+id/mx_lbl1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/w_warning" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/mx_cnt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/w_warning" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ListView android:id="@+id/mx_l1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
                <TextView android:id="@+id/mx_e1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Clear" android:textColor="@color/w_text_tertiary" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

            <LinearLayout android:id="@+id/mx_q2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_margin="2.5dp" android:padding="9dp" android:background="@drawable/widget_tile_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="2dp">
                    <TextView android:id="@+id/mx_lbl2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/w_info" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/mx_cnt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/w_info" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ListView android:id="@+id/mx_l2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
                <TextView android:id="@+id/mx_e2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Clear" android:textColor="@color/w_text_tertiary" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/mx_q3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_margin="2.5dp" android:padding="9dp" android:background="@drawable/widget_tile_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="2dp">
                    <TextView android:id="@+id/mx_lbl3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/w_teal" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/mx_cnt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/w_teal" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ListView android:id="@+id/mx_l3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
                <TextView android:id="@+id/mx_e3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Clear" android:textColor="@color/w_text_tertiary" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
