<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mx_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_bg_light">
            <TextView android:id="@+id/mx_q1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#E5484D" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Do first" android:textColor="#8A8699" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_bg_light">
            <TextView android:id="@+id/mx_q2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#F59E0B" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Schedule" android:textColor="#8A8699" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_bg_light">
            <TextView android:id="@+id/mx_q3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#3E7BFA" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delegate" android:textColor="#8A8699" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_bg_light">
            <TextView android:id="@+id/mx_q4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#12A594" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Later" android:textColor="#8A8699" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
