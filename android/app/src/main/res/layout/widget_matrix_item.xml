<?xml version="1.0" encoding="utf-8"?>
<!-- One task row inside an Eisenhower quadrant list. A coloured bullet + the task title; the whole row
     opens that task. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mx_i_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/mx_i_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="•"
        android:textColor="@color/w_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/mx_i_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Task"
        android:textColor="@color/w_text_primary"
        android:textSize="12sp" />
</LinearLayout>
