<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      NO android.permission.INTERNET is declared. The app is incapable of network
      access: fully offline and private by construction.
      The permissions below are all local-only: scheduling reminders, posting
      notifications, and reading a user-chosen backup file (no network of any kind).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      Browse & read a user-chosen backup file with NO system document picker (de-Googled ROMs lack
      com.android.documentsui). These are LOCAL-STORAGE permissions only — they grant filesystem access,
      never network. INTERNET remains absent, so the app is still incapable of any network access.
      The primary import path (Open with / Share → ToDo Companion) needs NEITHER of these; they only
      back the optional in-app file browser.
      READ_EXTERNAL_STORAGE is capped at API 29 (it does nothing for non-media files on 30+);
      MANAGE_EXTERNAL_STORAGE ("All files access", user-granted & revocable) covers API 30+.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToDoCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.ToDoCompanion.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- H1: capture from the system share sheet — any app can share text into a new task. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- H1: capture selected text via the text-selection menu (Android 6+). -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
              E9 — the robust import path for de-Googled phones: let the user's OWN file manager hand
              the backup to us via "Open with → ToDo Companion". The resulting content:// URI carries a
              temporary read grant, so NO storage permission or system document picker is involved — the
              one channel that survives a stripped-down AOSP ROM. Still fully offline.
            -->
            <!--
              Broad by design: a de-Googled file manager tags a .json backup as anything from
              application/json to text/plain to application/octet-stream, so we accept every data/text
              MIME (application/* + text/*). Media types (image/*, video/*) are deliberately NOT matched,
              so we only surface in "Open with" for documents/data — exactly the backup case.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!-- file:// paths some managers hand over with no usable MIME — match by extension instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.todobackup" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
            <!-- Share a backup INTO the app: "Share → ToDo Companion". Non-text SEND only (text/plain stays quick-add). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- Shares a decoded attachment with a local viewer app. Grants are per-URI + temporary. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen "Today" widget: task count + quick-add. Offline, reads local DB. -->
        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- Home-screen "Agenda" list widget: today's + overdue tasks. Offline, reads local DB. -->
        <receiver
            android:name=".widget.AgendaWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>
        <service
            android:name=".widget.AgendaWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Per-widget configuration screen (which scope/list, title, theme). Offline. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.ToDoCompanion">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Countdown widget: days remaining to a pinned date. Offline. -->
        <receiver
            android:name=".widget.CountdownWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>

        <!-- Compact quick-add button widget. -->
        <receiver
            android:name=".widget.QuickAddWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quickadd_info" />
        </receiver>

        <!-- Stats widget: tasks done today + still due. Offline. -->
        <receiver android:name=".widget.StatsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_stats_info" />
        </receiver>

        <!-- Matrix widget: quadrant counts. Offline. -->
        <receiver android:name=".widget.MatrixWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_matrix_info" />
        </receiver>

        <!-- Pomodoro launcher widget. Offline. -->
        <receiver android:name=".widget.PomodoroWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pomodoro_info" />
        </receiver>

        <!-- Habits check-in widget: today's habits, tap to check. Offline. -->
        <receiver android:name=".widget.HabitsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habits_info" />
        </receiver>
        <service
            android:name=".widget.HabitsWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <receiver android:name=".widget.HabitCheckReceiver" android:exported="false" />

        <receiver android:name=".widget.DoNextWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_donext_info" />
        </receiver>
        <service
            android:name=".widget.DoNextWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <receiver android:name=".widget.DoNextFilterReceiver" android:exported="false" />

        <receiver android:name=".widget.Next7Widget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next7_info" />
        </receiver>

        <receiver android:name=".widget.HabitStatsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habitstats_info" />
        </receiver>

        <!-- H5: Quick Settings tile → jump straight into quick-add from the notification shade. -->
        <service
            android:name=".tiles.CaptureTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_input_add"
            android:label="@string/tile_capture_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Fires scheduled reminder / summary / habit notifications. Not exported. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Reschedules pending reminders after a device reboot. -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
