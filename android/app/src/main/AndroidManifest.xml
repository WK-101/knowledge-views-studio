<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      NO android.permission.INTERNET is declared. The app is incapable of network
      access: fully offline and private by construction.
      The permissions below are all local-only: scheduling reminders, posting
      notifications, and reading a user-chosen backup file (no network of any kind).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- R59: the "Insistent" reminder tier presents a full-screen alarm once ignored a few rounds. This is
         a local UI capability only (no network, no location) — it lets the escalation take over the screen
         like a clock alarm. Without it, Android 14+ silently degrades the alarm to a heads-up notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- R59 (Wave 3): silence notifications (Do Not Disturb) during a Focus session. A local capability only
         (no network, no location); it takes effect only after the user grants DND access in system settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      NO storage or media permission is declared. Attaching files, restoring backups and importing all
      go through the SYSTEM pickers — the Android Photo Picker (PickVisualMedia), the Storage Access
      Framework document picker (GET_CONTENT / OPEN_DOCUMENT), and the system camera app (via a
      FileProvider URI). Each hands back exactly the file(s) the user selects, scoped to that item, so
      the app needs READ_EXTERNAL_STORAGE / READ_MEDIA_* / MANAGE_EXTERNAL_STORAGE for NOTHING. This is
      the TickTick-style, zero-storage-permission model. INTERNET remains absent too.
    -->

    <!-- Android 11+ package visibility: without these, ACTION_OPEN_DOCUMENT / GET_CONTENT / VIEW can
         resolve to "no handler" (ActivityNotFoundException) even when a file picker exists, because the
         app can't "see" the picker package. Declaring the intents we launch makes resolution reliable so
         attaching / opening files works out of the box on stock ROMs. Fully offline — no network intents. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- R41: camera + gallery + the system Photo Picker. On Android 11+ package visibility, launching
             ACTION_IMAGE_CAPTURE / ACTION_PICK throws "no activity found" unless the app can SEE the
             handling packages — this is exactly what Todoist declares. SAF (OPEN_DOCUMENT above) is
             visibility-exempt, but these third-party-handled intents are not. All local; no network. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToDoCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:label="@string/app_name"
            android:theme="@style/Theme.ToDoCompanion.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- R17: static launcher long-press shortcuts (Quick add, Today, Do-Next, Focus). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- R17: deep links for the static shortcuts that open the app (Today/Do-Next/Focus). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="todocompanion" android:host="today" />
                <data android:scheme="todocompanion" android:host="donext" />
                <data android:scheme="todocompanion" android:host="focus" />
            </intent-filter>
            <!-- H1: capture from the system share sheet — any app can share text into a new task. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- H1: capture selected text via the text-selection menu (Android 6+). -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
              E9 — the robust import path for de-Googled phones: let the user's OWN file manager hand
              the backup to us via "Open with → ToDo Companion". The resulting content:// URI carries a
              temporary read grant, so NO storage permission or system document picker is involved — the
              one channel that survives a stripped-down AOSP ROM. Still fully offline.
            -->
            <!--
              Broad by design: a de-Googled file manager tags a .json backup as anything from
              application/json to text/plain to application/octet-stream, so we accept every data/text
              MIME (application/* + text/*). Media types (image/*, video/*) are deliberately NOT matched,
              so we only surface in "Open with" for documents/data — exactly the backup case.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!-- file:// paths some managers hand over with no usable MIME — match by extension instead.
                 R103: AGP 8.7 lint (AppLinkUrlError) wants a host alongside these pathPatterns, but adding
                 android:host="*" would REQUIRE an authority to match, and the file:// URIs de-Googled file
                 managers deliver carry an EMPTY authority — so a host would break this fallback rather than
                 fix it. The no-host form is deliberate (the patterns are best-effort extension hints); the
                 robust import paths are the content:// filter above, the SEND filter below, and SAF. Scoped
                 ignore, not a global disable, so the check still guards the app's real deep-link filters. -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.todobackup" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
            <!-- Share a backup INTO the app: "Share → ToDo Companion". Non-text SEND only (text/plain stays quick-add). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <!-- U13: an NFC tag or QR encoding todocompanion://track?activity=<id> starts a timer. Offline; no permission. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="todocompanion" android:host="track" />
                <data android:scheme="todocompanion" android:host="routine" />
                <!-- R59: permission-free place reminders — an NFC tag / QR encoding
                     todocompanion://arrive?place=<name> fires the reminders armed for that place. -->
                <data android:scheme="todocompanion" android:host="arrive" />
            </intent-filter>
        </activity>

        <!-- Shares a decoded attachment with a local viewer app. Grants are per-URI + temporary. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen "Today" widget: task count + quick-add. Offline, reads local DB. -->
        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- Home-screen "Agenda" list widget: today's + overdue tasks. Offline, reads local DB. -->
        <receiver
            android:name=".widget.AgendaWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>
        <service
            android:name=".widget.AgendaWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Per-widget configuration screen (which scope/list, title, theme). Offline. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.ToDoCompanion">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- R17: translucent quick-capture popup — add a task straight from the widget/shortcut without
             opening the whole app. Floats in its own task so the main UI never comes forward. Offline. -->
        <activity
            android:name=".widget.QuickCaptureActivity"
            android:exported="true"
            android:theme="@style/Theme.ToDoCompanion.QuickCapture"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="todocompanion" android:host="add" />
            </intent-filter>
        </activity>

        <!-- Countdown widget: days remaining to a pinned date. Offline. -->
        <receiver
            android:name=".widget.CountdownWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>

        <!-- Compact quick-add button widget. -->
        <receiver
            android:name=".widget.QuickAddWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quickadd_info" />
        </receiver>

        <!-- Stats widget: tasks done today + still due. Offline. -->
        <receiver android:name=".widget.StatsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_stats_info" />
        </receiver>

        <!-- Matrix widget: quadrant counts. Offline. -->
        <receiver android:name=".widget.MatrixWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_matrix_info" />
        </receiver>

        <!-- Pomodoro launcher widget. Offline. -->
        <receiver android:name=".widget.PomodoroWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pomodoro_info" />
        </receiver>

        <!-- Habits check-in widget: today's habits, tap to check. Offline. -->
        <receiver android:name=".widget.HabitsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habits_info" />
        </receiver>
        <service
            android:name=".widget.HabitsWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <receiver android:name=".widget.HabitCheckReceiver" android:exported="false" />

        <receiver android:name=".widget.DoNextWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_donext_info" />
        </receiver>
        <service
            android:name=".widget.DoNextWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <receiver android:name=".widget.DoNextFilterReceiver" android:exported="false" />

        <receiver android:name=".widget.Next7Widget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next7_info" />
        </receiver>

        <receiver android:name=".widget.HabitStatsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habitstats_info" />
        </receiver>

        <!-- R1: Momentum widget — the unified habit+task+focus score. Offline. -->
        <receiver android:name=".widget.MomentumWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_momentum_info" />
        </receiver>

        <!-- R66: The Record widget — a scrolling list of recently finished tasks, wins first. Offline. -->
        <receiver android:name=".widget.RecordWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_record_info" />
        </receiver>
        <service
            android:name=".widget.RecordWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Round 13: Time tracker widget — the running timer + one-tap start/stop of your activities. Offline. -->
        <receiver android:name=".widget.TimeWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_time_info" />
        </receiver>
        <receiver android:name=".widget.TimeTrackReceiver" android:exported="false" />

        <!-- V8: local intent API — automation apps (Tasker/MacroDroid) can start/stop tracking. Local IPC, no network. -->
        <receiver android:name=".reminders.TimeIntentReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.todocompanion.app.api.START_ACTIVITY" />
                <action android:name="com.todocompanion.app.api.STOP_ACTIVITY" />
                <action android:name="com.todocompanion.app.api.STOP_ALL" />
            </intent-filter>
        </receiver>

        <!-- H5: Quick Settings tile → jump straight into quick-add from the notification shade. -->
        <service
            android:name=".tiles.CaptureTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_input_add"
            android:label="@string/tile_capture_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Round 13: Quick Settings tile — stop the running timer, or jump into Time. Offline. -->
        <service
            android:name=".tiles.TrackTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_recent_history"
            android:label="@string/tile_track_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- R36 · FW-1: Quick Settings tile — one-tap habit check-in from the shade, or open Habits. Offline. -->
        <service
            android:name=".tiles.HabitTileService"
            android:exported="true"
            android:icon="@android:drawable/checkbox_on_background"
            android:label="@string/tile_habit_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Fires scheduled reminder / summary / habit notifications. Not exported. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Reschedules pending reminders after a device reboot. -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
